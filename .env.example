# Copy to .env and fill in. These are read by index.mjs at startup.
# Keep .env out of git.

# Base URL of your BlueBubbles server (runs on your Mac). Default shown.
BLUEBUBBLES_URL=http://127.0.0.1:1234

# BlueBubbles server password (Settings -> Users/API in the BlueBubbles macOS app).
BLUEBUBBLES_API_KEY=your-bluebubbles-server-password

# Your own iMessage handle so the agent can message "yourself".
# Phone: +15551234567   Email: you@icloud.com
BLUEBUBBLES_SELF_HANDLE=+15551234567

# Optional: override the chat GUID used for receive. Usually leave blank;
# the bridge derives it as iMessage;<BLUEBUBBLES_SELF_HANDLE>.
# BLUEBUBBLES_DEFAULT_CHAT=iMessage;+15551234567
